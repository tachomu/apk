<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingLeft="18dp"
        android:paddingRight="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ДЕСЯТИЙ · ЇЖА"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"/>

        <TextView
            android:id="@+id/statusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingTop="7dp"
            android:paddingRight="10dp"
            android:paddingBottom="7dp"
            android:background="@drawable/bg_secondary"
            android:text="НЕ ЗАПУЩЕНО"
            android:textColor="@color/muted"
            android:textSize="10sp"/>

        <Button
            android:id="@+id/statsButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/bg_secondary"
            android:text="📊"
            android:textColor="@color/text"
            android:textSize="18sp"/>

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/bg_secondary"
            android:text="⚙"
            android:textColor="@color/text"
            android:textSize="18sp"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- FOOD -->
        <ScrollView
            android:id="@+id/foodPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/cycleLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ДЕНЬ ЩЕ НЕ ЗАПУЩЕНО"
                        android:textColor="@color/muted"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:id="@+id/countdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="ПОЧАТИ ДЕНЬ"
                        android:textColor="@color/text"
                        android:textSize="40sp"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:id="@+id/deadlineText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Пробудження запускає їжу і воду"
                        android:textColor="@color/muted"
                        android:textSize="14sp"/>
                    <ProgressBar
                        android:id="@+id/cycleProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="18dp"
                        android:max="1000"
                        android:progressTint="@color/accent"
                        android:progressBackgroundTint="@color/line"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/mealDotsText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="○  ○  ○"
                                android:textColor="@color/accent"
                                android:textSize="20sp"/>
                            <TextView
                                android:id="@+id/mealsText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 / 3+ прийомів"
                                android:textColor="@color/text"
                                android:textSize="13sp"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/snacksText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ПЕРЕКУСИ 0"
                            android:textColor="@color/muted"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/flowHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/flowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="КОЛИ СІДАЄШ ЇСТИ"
                        android:textColor="@color/muted"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/flowSteps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Фото → їжа → завершення"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:lineSpacingExtra="6dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/primaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_primary"
                    android:text="Я ПРОКИНУВСЯ"
                    android:textAllCaps="false"
                    android:textColor="@color/bg"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"/>

                <LinearLayout
                    android:id="@+id/secondaryActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <Button
                        android:id="@+id/snackButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginRight="4dp"
                        android:background="@drawable/bg_secondary"
                        android:text="ПЕРЕКУС → ФОТО"
                        android:textAllCaps="false"
                        android:textColor="@color/text"
                        android:textSize="13sp"/>
                    <Button
                        android:id="@+id/delayButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="4dp"
                        android:background="@drawable/bg_secondary"
                        android:text="НЕ МОЖУ · +15 ХВ"
                        android:textAllCaps="false"
                        android:textColor="@color/text"
                        android:textSize="13sp"
                        android:visibility="gone"/>
                </LinearLayout>

                <Button
                    android:id="@+id/extendEatingButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_secondary"
                    android:text="ЩЕ ЇМ +10 ХВ"
                    android:textAllCaps="false"
                    android:textColor="@color/text"
                    android:visibility="gone"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ОСТАННЯ ПОДІЯ"
                        android:textColor="@color/muted"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/lastEventText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Поки порожньо"
                        android:textColor="@color/text"
                        android:textSize="14sp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/sleepButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_secondary"
                    android:text="ЛЯГАЮ СПАТИ / ЗАВЕРШИТИ ДЕНЬ"
                    android:textAllCaps="false"
                    android:textColor="@color/muted"
                    android:visibility="gone"/>
            </LinearLayout>
        </ScrollView>

        <!-- WATER -->
        <ScrollView
            android:id="@+id/waterPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/waterStateText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ДЕНЬ НЕ ЗАПУЩЕНО"
                        android:textColor="@color/muted"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/waterTotalText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0 / 2500 мл"
                        android:textColor="@color/text"
                        android:textSize="42sp"
                        android:fontFamily="sans-serif-medium"/>
                    <com.mealcoach.app.HydrationTankView
                        android:id="@+id/hydrationTankView"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="12dp"/>
                    <ProgressBar
                        android:id="@+id/waterProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginTop="14dp"
                        android:max="2500"
                        android:progress="0"
                        android:progressTint="#5AA9FF"
                        android:progressBackgroundTint="@color/line"/>
                    <TextView
                        android:id="@+id/waterPaceText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Темп стартує від фактичного пробудження."
                        android:textColor="@color/muted"
                        android:textSize="14sp"/>
                    <TextView
                        android:id="@+id/waterWarningText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="—"
                        android:textColor="@color/text"
                        android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/waterQuick1"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:layout_marginRight="4dp"
                        android:background="@drawable/bg_secondary"
                        android:text="+250"
                        android:textColor="@color/text"/>
                    <Button
                        android:id="@+id/waterQuick2"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="4dp"
                        android:background="@drawable/bg_secondary"
                        android:text="+350"
                        android:textColor="@color/text"/>
                    <Button
                        android:id="@+id/waterQuick3"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="4dp"
                        android:background="@drawable/bg_secondary"
                        android:text="+500"
                        android:textColor="@color/text"/>
                </LinearLayout>

                <Button
                    android:id="@+id/waterCustomButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_primary"
                    android:text="ВВЕСТИ СВОЮ КІЛЬКІСТЬ"
                    android:textAllCaps="false"
                    android:textColor="@color/bg"/>

                <Button
                    android:id="@+id/waterUndoButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_secondary"
                    android:text="СКАСУВАТИ ОСТАННЄ"
                    android:textAllCaps="false"
                    android:textColor="@color/muted"
                    android:visibility="gone"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ТЕМП ЗА WAKE-ДЕНЬ"
                        android:textColor="@color/muted"
                        android:textSize="12sp"/>
                    <com.mealcoach.app.WaterTimelineView
                        android:id="@+id/waterTimelineView"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ОСТАННІ ЗАПИСИ"
                        android:textColor="@color/muted"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/waterHistoryText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Поки порожньо"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:lineSpacingExtra="5dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- STREAK -->
        <ScrollView
            android:id="@+id/streakPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/streakRankText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="СТАРТ"
                        android:textColor="@color/muted"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/streakDaysText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0 ДНІВ"
                        android:textColor="@color/text"
                        android:textSize="54sp"
                        android:fontFamily="sans-serif-medium"/>

                    <com.mealcoach.app.StreakSceneView
                        android:id="@+id/streakSceneView"
                        android:layout_width="match_parent"
                        android:layout_height="210dp"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:id="@+id/streakStatsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="Рекорд 0 • чистих днів 1/1"
                        android:textColor="@color/muted"
                        android:textSize="14sp"/>
                    <TextView
                        android:id="@+id/streakNextText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center"
                        android:text="До наступного апгрейду"
                        android:textColor="@color/text"
                        android:textSize="14sp"/>
                    <TextView
                        android:id="@+id/streakBadgesText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center"
                        android:text="Бейджі відкриються на 3 дні"
                        android:textColor="@color/muted"
                        android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ДНІ СЕРІЇ"
                        android:textColor="@color/muted"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/streakMarksText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Ще немає завершених днів"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:lineSpacingExtra="5dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="АРХІВ СЕРІЙ"
                        android:textColor="@color/muted"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/streakArchiveText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Попередніх серій ще немає"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:lineSpacingExtra="5dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/streakResetButton"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_danger"
                    android:text="ПОДРОЧИВ"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>
            </LinearLayout>
        </ScrollView>

        <!-- STATS -->
        <ScrollView
            android:id="@+id/statsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="СЬОГОДНІ"
                        android:textColor="@color/muted"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/currentStatsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="—"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:lineSpacingExtra="6dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="ЇЖА" android:textColor="@color/muted" android:textSize="11sp"/>
                    <ProgressBar android:id="@+id/statsFoodProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:max="3" android:progress="0" android:progressTint="@color/accent" android:progressBackgroundTint="@color/line"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="ВОДА" android:textColor="@color/muted" android:textSize="11sp"/>
                    <ProgressBar android:id="@+id/statsWaterProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:max="2500" android:progress="0" android:progressTint="@color/accent" android:progressBackgroundTint="@color/line"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="СЕРІЯ ДО НАСТУПНОГО АПГРЕЙДУ" android:textColor="@color/muted" android:textSize="11sp"/>
                    <ProgressBar android:id="@+id/statsStreakProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:max="7" android:progress="0" android:progressTint="#BE78FF" android:progressBackgroundTint="@color/line"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ОСТАННІ WAKE-ДНІ"
                        android:textColor="@color/muted"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/historyStatsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Ще немає даних"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:lineSpacingExtra="6dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/closeStatsButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_primary"
                    android:text="ГОТОВО"
                    android:textColor="@color/bg"/>
            </LinearLayout>
        </ScrollView>

        <!-- SETTINGS -->
        <ScrollView
            android:id="@+id/settingsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="МОДУЛІ"
                        android:textColor="@color/muted"
                        android:textSize="12sp"/>
                    <Button android:id="@+id/foodModuleButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="9dp" android:background="@drawable/bg_secondary" android:text="ЇЖА: ON" android:textColor="@color/text"/>
                    <Button android:id="@+id/waterModuleButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_secondary" android:text="ВОДА: ON" android:textColor="@color/text"/>
                    <Button android:id="@+id/streakModuleButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_secondary" android:text="СЕРІЯ: ON" android:textColor="@color/text"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">
                    <TextView
                        android:text="НАДІЙНІСТЬ НАГАДУВАНЬ"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/muted"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/reliabilityText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Перевіряю дозволи..."
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"/>
                    <Button android:id="@+id/notificationSettingsButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:background="@drawable/bg_secondary" android:text="СПОВІЩЕННЯ" android:textColor="@color/text"/>
                    <Button android:id="@+id/exactAlarmButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_secondary" android:text="ТОЧНІ БУДИЛЬНИКИ" android:textColor="@color/text"/>
                    <Button android:id="@+id/fullScreenButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_secondary" android:text="FULL-SCREEN ALARM" android:textColor="@color/text"/>
                    <Button android:id="@+id/batteryButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_secondary" android:text="БАТАРЕЯ / БЕЗ ОБМЕЖЕНЬ" android:textColor="@color/text"/>
                    <Button android:id="@+id/accessibilityButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_secondary" android:text="ШТРАФ: БЛОК СОЦМЕРЕЖ" android:textColor="@color/text"/>
                    <Button android:id="@+id/autostartButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_secondary" android:text="АВТОЗАПУСК XIAOMI" android:textColor="@color/text"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ВОДА" android:textColor="@color/muted" android:textSize="12sp"/>
                    <Button android:id="@+id/waterGoalSettingsButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="9dp" android:background="@drawable/bg_secondary" android:text="ЦІЛЬ: 2500 МЛ" android:textColor="@color/text"/>
                    <Button android:id="@+id/waterQuickSettingsButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_secondary" android:text="ШВИДКІ КНОПКИ" android:textColor="@color/text"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ЗВУКИ" android:textColor="@color/muted" android:textSize="12sp"/>
                    <Button android:id="@+id/foodSoundButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="9dp" android:background="@drawable/bg_secondary" android:text="ЗВУК ЇЖІ: ВБУДОВАНИЙ" android:textColor="@color/text"/>
                    <Button android:id="@+id/waterSoundButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_secondary" android:text="ЗВУК ВОДИ: ВБУДОВАНИЙ" android:textColor="@color/text"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ТЕСТ НАГАДУВАНЬ" android:textColor="@color/muted" android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/testStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Не запущено"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"/>
                    <ProgressBar
                        android:id="@+id/testProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="10dp"
                        android:max="7"
                        android:progress="0"
                        android:progressTint="@color/accent"
                        android:progressBackgroundTint="@color/line"/>
                    <Button android:id="@+id/testButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:background="@drawable/bg_primary" android:text="ФОНОВИЙ ТЕСТ · 6 ХВ" android:textColor="@color/bg"/>
                    <Button android:id="@+id/testNextButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_secondary" android:text="НАСТУПНИЙ ЕТАП ЗАРАЗ" android:textColor="@color/text"/>
                    <Button android:id="@+id/diagnosticExportButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_secondary" android:text="ЕКСПОРТ ДІАГНОСТИКИ" android:textColor="@color/text"/>
                </LinearLayout>

                <Button
                    android:id="@+id/memeModeButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_secondary"
                    android:text="RESET-АНІМАЦІЯ: CINEMATIC"
                    android:textColor="@color/text"/>

                <Button
                    android:id="@+id/closeSettingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_primary"
                    android:text="ГОТОВО"
                    android:textColor="@color/bg"/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:orientation="horizontal"
        android:background="@color/card">
        <Button
            android:id="@+id/navFood"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary"
            android:text="ЇЖА"
            android:textColor="@color/accent"
            android:textSize="13sp"/>
        <Button
            android:id="@+id/navWater"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="7dp"
            android:background="@drawable/bg_secondary"
            android:text="ВОДА"
            android:textColor="@color/muted"
            android:textSize="13sp"/>
        <Button
            android:id="@+id/navStreak"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="7dp"
            android:background="@drawable/bg_secondary"
            android:text="СЕРІЯ"
            android:textColor="@color/muted"
            android:textSize="13sp"/>
    </LinearLayout>
</LinearLayout>