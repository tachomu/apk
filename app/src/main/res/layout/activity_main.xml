<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="В САШИНІ ТРУСІКІ"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"/>

        <TextView
            android:id="@+id/statusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="11dp"
            android:paddingTop="7dp"
            android:paddingRight="11dp"
            android:paddingBottom="7dp"
            android:background="@drawable/bg_secondary"
            android:text="НЕ ЗАПУЩЕНО"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/todayPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/cycleLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ДЕНЬ ЩЕ НЕ ЗАПУЩЕНО"
                        android:textColor="@color/muted"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"/>

                    <TextView
                        android:id="@+id/countdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="ПОЧАТИ ДЕНЬ"
                        android:textColor="@color/text"
                        android:textSize="40sp"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:id="@+id/deadlineText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Після пробудження запустимо перше вікно їжі"
                        android:textColor="@color/muted"
                        android:textSize="14sp"/>

                    <ProgressBar
                        android:id="@+id/cycleProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="18dp"
                        android:max="1000"
                        android:progress="0"
                        android:progressTint="@color/accent"
                        android:progressBackgroundTint="@color/line"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/mealDotsText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="○  ○  ○"
                                android:textColor="@color/accent"
                                android:textSize="20sp"
                                android:fontFamily="sans-serif-medium"/>

                            <TextView
                                android:id="@+id/mealsText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0 / 3+ прийомів"
                                android:textColor="@color/text"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/snacksText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ПЕРЕКУСИ  0"
                            android:textColor="@color/muted"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/flowHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/flowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="КОЛИ СІДАЄШ ЇСТИ"
                        android:textColor="@color/muted"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"/>

                    <TextView
                        android:id="@+id/flowSteps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="1  Сфотографуй їжу\n2  Починай їсти\n3  Коли закінчиш — натисни «Закінчив їсти»"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:lineSpacingExtra="7dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/primaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_primary"
                    android:text="Я ПРОКИНУВСЯ"
                    android:textAllCaps="false"
                    android:textColor="@color/bg"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"/>

                <LinearLayout
                    android:id="@+id/secondaryActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/snackButton"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:layout_marginRight="5dp"
                        android:background="@drawable/bg_secondary"
                        android:text="ПЕРЕКУС → ФОТО"
                        android:textAllCaps="false"
                        android:textColor="@color/text"
                        android:textSize="14sp"/>

                    <Button
                        android:id="@+id/delayButton"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="5dp"
                        android:background="@drawable/bg_secondary"
                        android:text="НЕ МОЖУ · +15 ХВ"
                        android:textAllCaps="false"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:visibility="gone"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lastEventCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ОСТАННЯ ПОДІЯ"
                        android:textColor="@color/muted"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"/>

                    <TextView
                        android:id="@+id/lastEventText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Поки порожньо"
                        android:textColor="@color/text"
                        android:textSize="14sp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/sleepButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_secondary"
                    android:text="ЗАВЕРШИТИ ДЕНЬ / ЛЯГАЮ СПАТИ"
                    android:textAllCaps="false"
                    android:textColor="@color/muted"
                    android:textSize="13sp"
                    android:visibility="gone"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="3 прийоми — мінімум, не ліміт"
                    android:textColor="@color/muted"
                    android:textSize="12sp"/>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/historyPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ІСТОРІЯ ХАРЧУВАННЯ"
                        android:textColor="@color/muted"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"/>

                    <TextView
                        android:id="@+id/historyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Поки порожньо"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:lineSpacingExtra="6dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/exportButton"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_secondary"
                    android:text="ЕКСПОРТ ЖУРНАЛУ В CSV"
                    android:textAllCaps="false"
                    android:textColor="@color/text"/>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/settingsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="НАДІЙНІ НАГАДУВАННЯ"
                        android:textColor="@color/muted"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="На Xiaomi краще один раз перевірити ці дозволи. Кнопки відкривають потрібні системні екрани."
                        android:textColor="@color/text"
                        android:textSize="14sp"/>

                    <Button
                        android:id="@+id/notificationSettingsButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_secondary"
                        android:text="СПОВІЩЕННЯ"
                        android:textAllCaps="false"
                        android:textColor="@color/text"/>

                    <Button
                        android:id="@+id/exactAlarmButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_secondary"
                        android:text="ТОЧНІ БУДИЛЬНИКИ"
                        android:textAllCaps="false"
                        android:textColor="@color/text"/>

                    <Button
                        android:id="@+id/batteryButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_secondary"
                        android:text="ОБМЕЖЕННЯ БАТАРЕЇ"
                        android:textAllCaps="false"
                        android:textColor="@color/text"/>

                    <Button
                        android:id="@+id/autostartButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_secondary"
                        android:text="АВТОЗАПУСК XIAOMI"
                        android:textAllCaps="false"
                        android:textColor="@color/text"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ТЕСТ НАГАДУВАНЬ"
                        android:textColor="@color/muted"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"/>

                    <TextView
                        android:id="@+id/testStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="6 хвилин: кожна стадія ескалації проходить приблизно за хвилину."
                        android:textColor="@color/text"
                        android:textSize="14sp"/>

                    <Button
                        android:id="@+id/testButton"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_primary"
                        android:text="ЗАПУСТИТИ ТЕСТ · 6 ХВ"
                        android:textAllCaps="false"
                        android:textColor="@color/bg"
                        android:fontFamily="sans-serif-medium"/>

                    <Button
                        android:id="@+id/diagnosticExportButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_secondary"
                        android:text="ЕКСПОРТ ДІАГНОСТИКИ"
                        android:textAllCaps="false"
                        android:textColor="@color/text"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="В Сашині трусікі · v2"
                    android:textColor="@color/muted"
                    android:textSize="12sp"/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:orientation="horizontal"
        android:background="@color/card">

        <Button
            android:id="@+id/navToday"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary"
            android:text="СЬОГОДНІ"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="7dp"
            android:background="@drawable/bg_secondary"
            android:text="ІСТОРІЯ"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="7dp"
            android:background="@drawable/bg_secondary"
            android:text="НАЛАШТ."
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
