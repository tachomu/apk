<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/alarmLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="МАКСИМАЛЬНА МЕЖА"
        android:textColor="@color/danger"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.10"/>

    <TextView
        android:id="@+id/alarmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Час почати їсти"
        android:textColor="@color/text"
        android:textSize="34sp"
        android:fontFamily="sans-serif-medium"/>

    <TextView
        android:id="@+id/alarmBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Сигнал припиниться тільки після того, як ти відкриєш «В Сашині трусікі», сфотографуєш їжу і почнеш прийом."
        android:textColor="@color/muted"
        android:textSize="16sp"/>

    <Button
        android:id="@+id/alarmStartButton"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="34dp"
        android:background="@drawable/bg_primary"
        android:text="СФОТОГРАФУВАТИ ЇЖУ → ПОЧАТИ"
        android:textAllCaps="false"
        android:textColor="@color/bg"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"/>
</LinearLayout>
